{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: tabular_to_text",
      "type": "debugpy",
      "request": "launch",
      "module": "src.counterfactual_generation.tabular_counterfactual_generation.tabular_to_text",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: heart_disease template",
      "type": "debugpy",
      "request": "launch",
      "module": "src.templates.heart_disease",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: generate_predictor_answers",
      "type": "debugpy",
      "request": "launch",
      "module": "src.prediction_generation.generate_predictor_answers",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "CUDA_VISIBLE_DEVICES": "3"
      },
      "args": [
        "experiments/q4bcompas1000-reference_answers.parquet",
        "--output-parquet","experiments/q4bcompas1000-predictor_answers.parquet",
        "--model","openai/gpt-oss-20b",
        "--batch-size","10000"
      ]
    },
    {
  "name": "Debug: generate_reference_answers (heart_disease)",
  "type": "debugpy",
  "request": "launch",
  "module": "src.reference_answer_generation.generate_reference_answers",
  "cwd": "${workspaceFolder}",
  "console": "integratedTerminal",
  "env": {
    "CUDA_VISIBLE_DEVICES": "3"
  },
  "args": [
    "tabular_results/heart_disease_counterfactual_dataset_balanced.parquet",
    "--output-parquet", "tabular_results/heart_disease_counterfactual_dataset_reference.parquet",
    "--model", "Qwen/Qwen3-8B",
    "--batch-size", "10000"
  ]
},
{
  "name": "Debug: analyse_simulatibilty_results (heart_disease)",
  "type": "debugpy",
  "request": "launch",
  "module": "analysis_scripts.analyze_simulatability",
  "cwd": "${workspaceFolder}",
  "console": "integratedTerminal",
  "env": {
    "CUDA_VISIBLE_DEVICES": "3"
  },
  "args": [
    "tabular_results/predictor_results",
    "--output", "results/3qwen/3qwen_simulatability_analysis.csv",
    "--multi-predictor",
    "--normalized",
  ]
},
{
  "name": "Debug: analyse_model_correlation",
  "type": "debugpy",
  "request": "launch",
  "module": "analysis_scripts.analyze_model_correlation",
  "cwd": "${workspaceFolder}",
  "console": "integratedTerminal",
  "env": {
    "CUDA_VISIBLE_DEVICES": "3"
  },
  "args": [
    "tabular_results/predictor_results/qwen_scaling.parquet",
    "--output-dir", "results/3qwen/3qwen_correlation_analysis.csv",
  ]
},
{
  "name": "Debug: analyse_scaling_laws",
  "type": "debugpy",
  "request": "launch",
  "module": "analysis_scripts.analyze_scaling_laws",
  "cwd": "${workspaceFolder}",
  "console": "integratedTerminal",
  "env": {
    "CUDA_VISIBLE_DEVICES": "3"
  },
  "args": [
    "tabular_results/predictor_results",
    "--output", "results/3qwen/3qwen_scaling_laws.csv",
  ]
}

  ]
}
